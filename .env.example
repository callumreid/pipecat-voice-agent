# Daily.co — WebRTC transport
DAILY_ROOM_URL=https://your-domain.daily.co/your-room
DAILY_TOKEN=                    # optional — only needed for private rooms

# AI services
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
CARTESIA_API_KEY=...
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22   # default: Helpful Woman

# Coval tracing
COVAL_API_KEY=                  # your Coval org API key
COVAL_SIMULATION_ID=            # set this to the simulation output ID before each test run

# Optional: also print spans to console for local debugging
OTEL_CONSOLE_EXPORT=false
